# ─── CFDI-AES — Variables de entorno: STAGING ────────────────────────────────
# Copiar como .env.staging y rellenar con valores reales del ambiente de
# Staging (ver docs/ambientes.md) - NUNCA con los mismos secretos de Dev local
# ni de Produccion.
# NUNCA commitear el .env.staging con credenciales reales.
#
# Uso: docker compose --env-file .env.staging up -d
# (el .env sin sufijo sigue siendo el de Dev local - ver docker-compose.yml
# y docs/ambientes.md para la diferencia entre ambos).

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=staging

# ── Postgres (una base por microservicio) ──────────────────────────────────────
# Base de datos propia de Staging, separada de Dev (ver docs/ambientes.md,
# checklist Dev -> Staging) - un Postgres fisico distinto, no solo un nombre
# de BD distinto en el mismo servidor. DB/USER pueden quedarse igual a Dev
# (son solo el nombre logico dentro de ese Postgres separado); lo que SI debe
# cambiar siempre es el PASSWORD.
POSTGRES_DB_FACTURAS=cfdi_facturas
POSTGRES_USER_FACTURAS=cfdi
POSTGRES_PASSWORD_FACTURAS=cambia_esto_password_staging_facturas

POSTGRES_DB_ADMIN=cfdi_admin
POSTGRES_USER_ADMIN=cfdi
POSTGRES_PASSWORD_ADMIN=cambia_esto_password_staging_admin

POSTGRES_DB_AUTH=cfdi_auth
POSTGRES_USER_AUTH=cfdi
POSTGRES_PASSWORD_AUTH=cambia_esto_password_staging_auth

POSTGRES_DB_BOT=cfdi_bot
POSTGRES_USER_BOT=cfdi
POSTGRES_PASSWORD_BOT=cambia_esto_password_staging_bot

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Generar uno nuevo, distinto al de Dev y al de Produccion:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_esto_por_secreto_seguro_de_staging

# Clave interna entre microservicios (servicio-a-servicio) - distinta a Dev y
# a Produccion. Generar con: openssl rand -hex 32
INTERNAL_API_KEY=cambia_esto_por_clave_segura_de_staging

# ── PAC (Proveedor Autorizado de Certificación) ───────────────────────────────
# Regla no negociable de #19/docs/ambientes.md: Staging SIEMPRE contra el
# sandbox de Finkok, NUNCA produccion de Finkok con datos de prueba. Mismos
# valores que Dev a proposito - no cambiar.
PAC_URL=https://demo-facturacion.finkok.com/servicios/soap/stamp.wsdl
PAC_CANCEL_URL=https://demo-facturacion.finkok.com/servicios/soap/cancel.wsdl
PAC_USER=tu_usuario_finkok_sandbox
PAC_PASS=tu_password_finkok_sandbox

# ── WhatsApp Business Cloud API (Meta) ────────────────────────────────────────
# Obtener en: https://developers.facebook.com/apps/<app_id>/whatsapp-business/
# Regla no negociable de #19/docs/ambientes.md: usar un numero de WhatsApp
# Business de PRUEBA, nunca el real de produccion (ver tarjeta de los 3
# ambientes).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=cambia_esto_numero_whatsapp_de_prueba_staging
WHATSAPP_VERIFY_TOKEN=cambia_esto_verify_token_staging

# ── Facturación ───────────────────────────────────────────────────────────────
EMISOR_RFC_DEFAULT=EKU9003173C9
NEGOCIO_ID_DEFAULT=1
PRIVACY_NOTICE_URL=https://staging.tudominio.mx/aviso-privacidad

# ── CSD (Certificado de Sello Digital) ────────────────────────────────────────
# CSD_CERT_PATH/CSD_KEY_PATH/CSD_PASSWORD eliminadas (#42): facturacion ya
# no firma con un archivo estatico en disco - pide el CSD real de cada
# emisor a administracion (GET /admin/emisores/{rfc}/csd-descifrado),
# cacheado por rfc. Ver INTERNAL_API_KEY mas arriba.

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=cambia_esto_minio_secret_staging

# ── IA (opcional, para el microservicio IA en puerto 8007) ───────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
