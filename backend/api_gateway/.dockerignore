# Secretos y configuración local — nunca deben entrar a la imagen
.env
.env.*
!.env.example

# Certificados y llaves privadas
*.cer
*.key
*.sdg

# Entornos virtuales y cachés de Python — se reinstalan con requirements.txt
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Control de versiones
.git/
.gitignore
