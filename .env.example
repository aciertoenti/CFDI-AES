# ─── CFDI-AES — Variables de entorno ─────────────────────────────────────────
# Copiar como .env y rellenar con valores reales.
# NUNCA commitear el .env con credenciales reales.

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Postgres (una base por microservicio) ──────────────────────────────────────
# Separacion Dev/Staging/Produccion (13 ago 2026, ver docs/ambientes.md) - antes
# estas credenciales estaban hardcodeadas directo en docker-compose.yml, sin
# pasar por variable de entorno en absoluto. Los valores de aqui abajo son los
# mismos defaults que docker-compose.yml ya usaba - este .env local puede
# quedarse tal cual, no es obligatorio definir estas variables para Dev.
POSTGRES_DB_FACTURAS=cfdi_facturas
POSTGRES_USER_FACTURAS=cfdi
POSTGRES_PASSWORD_FACTURAS=secret_facturas

POSTGRES_DB_ADMIN=cfdi_admin
POSTGRES_USER_ADMIN=cfdi
POSTGRES_PASSWORD_ADMIN=secret_admin

POSTGRES_DB_AUTH=cfdi_auth
POSTGRES_USER_AUTH=cfdi
POSTGRES_PASSWORD_AUTH=secret_auth

POSTGRES_DB_BOT=cfdi_bot
POSTGRES_USER_BOT=cfdi
POSTGRES_PASSWORD_BOT=secret_bot

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_esto_por_secreto_seguro

# Clave interna entre microservicios (servicio-a-servicio)
# Generar con: openssl rand -hex 32
INTERNAL_API_KEY=cambia_esto_por_clave_segura

# ── PAC (Proveedor Autorizado de Certificación) ───────────────────────────────
# PAC soportado: Finkok
# Demo:       https://demo-facturacion.finkok.com/servicios/soap/stamp.wsdl
# Producción: https://ws.finkok.com/servicios/soap/stamp.wsdl
PAC_URL=https://demo-facturacion.finkok.com/servicios/soap/stamp.wsdl
PAC_CANCEL_URL=https://demo-facturacion.finkok.com/servicios/soap/cancel.wsdl
PAC_USER=tu_usuario_finkok
PAC_PASS=tu_password_finkok

# ── WhatsApp Business Cloud API (Meta) ────────────────────────────────────────
# Obtener en: https://developers.facebook.com/apps/<app_id>/whatsapp-business/
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1152873881252049
WHATSAPP_VERIFY_TOKEN=test_verify

# ── Facturación ───────────────────────────────────────────────────────────────
EMISOR_RFC_DEFAULT=EKU9003173C9
# negocio_id real (en administracion) dueño de EMISOR_RFC_DEFAULT - usado por
# whatsapp_bot para mandar X-Negocio-Id a facturacion (ver core/config.py).
NEGOCIO_ID_DEFAULT=1
PRIVACY_NOTICE_URL=https://tudominio.mx/aviso-privacidad

# ── CSD (Certificado de Sello Digital) ────────────────────────────────────────
# CSD_CERT_PATH/CSD_KEY_PATH/CSD_PASSWORD eliminadas (#42): facturacion ya
# no firma con un archivo estatico en disco - pide el CSD real de cada
# emisor a administracion (GET /admin/emisores/{rfc}/csd-descifrado),
# cacheado por rfc. Ver INTERNAL_API_KEY mas abajo.

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret

# ── IA (opcional, para el microservicio IA en puerto 8006) ───────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ── Email transaccional (SendGrid) ────────────────────────────────────────────
# Usado por auth_usuarios (14 ago 2026) para el correo de recuperacion de
# contrasena - POST /auth/password-reset/request. Obtener API key en:
# https://app.sendgrid.com/settings/api_keys (scope minimo: Mail Send).
# Sin default debil en docker-compose.yml (falla explicito si falta).
SENDGRID_API_KEY=
# Remitente verificado en SendGrid (Single Sender o dominio autenticado) -
# SendGrid rechaza el envio si este correo no esta verificado en la cuenta.
SENDGRID_FROM_EMAIL=
# Dominio publico del frontend - usado para armar el link del correo de
# reset (https://FRONTEND_URL/reset-password?token=...). Default razonable
# para Dev local, sin fail-fast porque Staging/Produccion lo sobreescriben.
FRONTEND_URL=http://localhost:3000
