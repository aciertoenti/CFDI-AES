# ─── CFDI-AES — Variables de entorno: PRODUCCIÓN ─────────────────────────────
# Copiar como .env.production y rellenar con valores reales de Produccion
# (ver docs/ambientes.md, checklist Staging -> Produccion) - NUNCA con los
# mismos secretos de Dev local ni de Staging.
# NUNCA commitear el .env.production con credenciales reales.
#
# Uso: docker compose --env-file .env.production up -d
# (el .env sin sufijo sigue siendo el de Dev local - ver docker-compose.yml
# y docs/ambientes.md para la diferencia entre ambos).
#
# Antes de usar este archivo de verdad, revisar el checklist completo de
# "Staging -> Produccion" en docs/ambientes.md - separar credenciales es solo
# una parte de lo que falta (Finkok en modo produccion, verificacion de
# negocio de Meta, custodia real de CSD, migraciones manuales, etc.).

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Postgres (una base por microservicio) ──────────────────────────────────────
# Base de datos propia de Produccion, separada de Dev y de Staging - un
# Postgres fisico distinto. DB/USER pueden quedarse igual (nombre logico
# dentro de ese Postgres separado); el PASSWORD SIEMPRE debe ser unico.
POSTGRES_DB_FACTURAS=cfdi_facturas
POSTGRES_USER_FACTURAS=cfdi
POSTGRES_PASSWORD_FACTURAS=cambia_esto_password_produccion_facturas

POSTGRES_DB_ADMIN=cfdi_admin
POSTGRES_USER_ADMIN=cfdi
POSTGRES_PASSWORD_ADMIN=cambia_esto_password_produccion_admin

POSTGRES_DB_AUTH=cfdi_auth
POSTGRES_USER_AUTH=cfdi
POSTGRES_PASSWORD_AUTH=cambia_esto_password_produccion_auth

POSTGRES_DB_BOT=cfdi_bot
POSTGRES_USER_BOT=cfdi
POSTGRES_PASSWORD_BOT=cambia_esto_password_produccion_bot

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Generar uno nuevo, distinto al de Dev y al de Staging:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_esto_por_secreto_seguro_de_produccion

# Clave interna entre microservicios (servicio-a-servicio) - distinta a Dev y
# a Staging. Generar con: openssl rand -hex 32
INTERNAL_API_KEY=cambia_esto_por_clave_segura_de_produccion

# ── PAC (Proveedor Autorizado de Certificación) ───────────────────────────────
# Finkok en modo PRODUCCION real - requiere cuenta/contrato real con el PAC,
# distinto del acceso de pruebas usado en Dev/Staging (ver docs/ambientes.md).
PAC_URL=https://ws.finkok.com/servicios/soap/stamp.wsdl
PAC_CANCEL_URL=https://ws.finkok.com/servicios/soap/cancel.wsdl
PAC_USER=tu_usuario_finkok_produccion
PAC_PASS=tu_password_finkok_produccion

# ── WhatsApp Business Cloud API (Meta) ────────────────────────────────────────
# Obtener en: https://developers.facebook.com/apps/<app_id>/whatsapp-business/
# Numero de WhatsApp Business REAL de produccion. Ver #32 (docs/ambientes.md,
# checklist Staging -> Produccion): idealmente via el flujo de System User,
# no un token ligado a un perfil personal.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=cambia_esto_numero_whatsapp_real_produccion
WHATSAPP_VERIFY_TOKEN=cambia_esto_verify_token_produccion

# ── Facturación ───────────────────────────────────────────────────────────────
EMISOR_RFC_DEFAULT=EKU9003173C9
NEGOCIO_ID_DEFAULT=1
PRIVACY_NOTICE_URL=https://tudominio.mx/aviso-privacidad

# ── CSD (Certificado de Sello Digital) ────────────────────────────────────────
# CSD_CERT_PATH/CSD_KEY_PATH/CSD_PASSWORD eliminadas (#42): facturacion ya
# no firma con un archivo estatico en disco - pide el CSD real de cada
# emisor a administracion (GET /admin/emisores/{rfc}/csd-descifrado),
# cacheado por rfc. Ver INTERNAL_API_KEY mas arriba. En Produccion existen
# tantos CSD como clientes reales - custodia seria pendiente (ver
# docs/ambientes.md, checklist Staging -> Produccion).

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=cambia_esto_minio_secret_produccion

# ── IA (opcional, para el microservicio IA en puerto 8007) ───────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
