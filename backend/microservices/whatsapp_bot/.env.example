# ─── WhatsApp Bot — Variables de entorno ─────────────────────────────────────
# Copiar este archivo como .env y rellenar los valores reales.
# NUNCA commitear el .env con valores reales.

# Entorno
ENVIRONMENT=development
LOG_LEVEL=INFO

# Base de datos dedicada del bot
DATABASE_URL=postgresql+asyncpg://cfdi:secret_bot@postgres_bot:5432/cfdi_bot

# Redis (usa la instancia compartida, base de datos /2)
REDIS_URL=redis://redis:6379/2

# ── WhatsApp Business Cloud API (Meta) ────────────────────────────────────────
# Obtener en: https://developers.facebook.com/apps/<app_id>/whatsapp-business/wa-dev-console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_VERIFY_TOKEN=test_verify

# ── Microservicio CFDI-AES Facturación ───────────────────────────────────────
FACTURACION_URL=http://facturacion:8001
# Clave compartida entre microservicios (generar con: openssl rand -hex 32)
INTERNAL_API_KEY=cambia_esto_por_clave_generada_segura

# ── Datos del emisor por defecto ─────────────────────────────────────────────
EMISOR_RFC_DEFAULT=DNS010101AAA

# ── JWT (mismo secret que el gateway para consistencia) ─────────────────────
JWT_SECRET=cambia_en_produccion

# ── Privacidad y datos personales ────────────────────────────────────────────
PRIVACY_NOTICE_URL=https://tudominio.mx/aviso-privacidad
